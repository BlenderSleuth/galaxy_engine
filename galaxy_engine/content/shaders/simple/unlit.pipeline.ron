GraphicsPipeline(
    shaders: (
        vertex: (
            id: "common/apply_mvp_vs",
            input_type: PositionTexCoord,
        ),
        fragment: (
            id: "simple/unlit",
        ),
    ),
    //phase: Opaque,
    rasteriser: (
        multisample_enable: true,
        depth_enable: true,
    ),
    layout: (
        push_constant: DrawOffset, 
        bindings: {
            "base_colour": (
                type: Float3, 
                stages: "Fragment",
            ),
            "roughness": (
                type: Float, 
                stages: "Fragment",
            ),
            "normal": (
                type: Float2, 
                stages: "Fragment",
            ),
        }
    ),
)
